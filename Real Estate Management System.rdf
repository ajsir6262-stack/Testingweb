     -->

    


    <!-- http://schema.org/actionstatus -->

    <owl:DatatypeProperty rdf:about="http://schema.org/actionstatus">
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The status of an action, e.g., active, completed, cancelled.</rdfs:comment>
        <rdfs:label>schema:actionstatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/address -->

    <owl:DatatypeProperty rdf:about="http://schema.org/address">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://schema.org/Hostel"/>
                    <rdf:Description rdf:about="http://schema.org/Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>he physical address of a place or organization.</rdfs:comment>
        <rdfs:label>schema:address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/amount -->

    <owl:DatatypeProperty rdf:about="http://schema.org/amount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Installment"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Deposit"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/Investment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>A monetary amount or quantity.</rdfs:comment>
        <rdfs:label>schema:amount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/area -->

    <owl:DatatypeProperty rdf:about="http://schema.org/area">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001785"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The size of a property or space, typically in square meters or feet.</rdfs:comment>
        <rdfs:label>schema:area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/areaServed -->

    <owl:DatatypeProperty rdf:about="http://schema.org/areaServed">
        <rdfs:domain rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The geographic area where a service or organization operates.</rdfs:comment>
        <rdfs:label>schema:areaServed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/billingDuration -->

    <owl:DatatypeProperty rdf:about="http://schema.org/billingDuration">
        <rdfs:domain rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The time period for which a charge or bill applies.</rdfs:comment>
        <rdfs:label>schema:billingDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/billingStart -->

    <owl:DatatypeProperty rdf:about="http://schema.org/billingStart">
        <rdfs:domain rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date and time when billing for a service begins.</rdfs:comment>
        <rdfs:label>schema:billingStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/dateCreated -->

    <owl:DatatypeProperty rdf:about="http://schema.org/dateCreated">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C115464"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C48312"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date on which an item was created.</rdfs:comment>
        <rdfs:label>schema:dateCreated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/datePublished -->

    <owl:DatatypeProperty rdf:about="http://schema.org/datePublished">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date on which an item was published or made available.</rdfs:comment>
        <rdfs:label>schema:datePublished</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/description -->

    <owl:DatatypeProperty rdf:about="http://schema.org/description">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C48312"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A short textual description of an item.</rdfs:comment>
        <rdfs:label>schema:description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/email -->

    <owl:DatatypeProperty rdf:about="http://schema.org/email">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Email address of a person or organization.</rdfs:comment>
        <rdfs:label>schema:email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/endDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/endDate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C115464"/>
                    <rdf:Description rdf:about="http://schema.org/Reservation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date on which an event or period ends.</rdfs:comment>
        <rdfs:label>schema:endDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/endTime -->

    <owl:DatatypeProperty rdf:about="http://schema.org/endTime">
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The time at which an event or period ends.</rdfs:comment>
        <rdfs:label>schema:endTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/floorLevel -->

    <owl:DatatypeProperty rdf:about="http://schema.org/floorLevel">
        <rdfs:domain rdf:resource="http://schema.org/Apartment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The floor level of a property or room within a building.</rdfs:comment>
        <rdfs:label>schema:floorLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/floorSize -->

    <owl:DatatypeProperty rdf:about="http://schema.org/floorSize">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001222"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The total floor area of a property or space.</rdfs:comment>
        <rdfs:label>schema:floorSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/gender -->

    <owl:DatatypeProperty rdf:about="http://schema.org/gender">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The gender of a person e.g.Male or Female.</rdfs:comment>
        <rdfs:label>schema:gender</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/identifier -->

    <owl:DatatypeProperty rdf:about="http://schema.org/identifier">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C115464"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C205529"/>
                    <rdf:Description rdf:about="http://schema.org/RealEstateAgent"/>
                    <rdf:Description rdf:about="https://w3id.org/reproduceme#Owner"/>
