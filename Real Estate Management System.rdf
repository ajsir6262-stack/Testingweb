<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/"
     xml:base="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:envo="http://purl.obolibrary.org/obo/envo.owl#"
     xmlns:ncit="http://purl.obolibrary.org/obo/ncit.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="https://schema.org/"
     xmlns:schema1="http://schema.org/"
     xmlns:ontoavida="http://purl.obolibrary.org/obo/ontoavida.owl#"
     xmlns:reproduceme="https://w3id.org/reproduceme#"
     xmlns:untitled-ontology-33="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/ONTOAVIDA_00001200 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/ONTOAVIDA_00001200">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isPropertyInvolvedIn"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>Relates an event, transaction, or process to the property it concerns.</rdfs:comment>
        <rdfs:label>involvesProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/hasPart -->

    <owl:ObjectProperty rdf:about="http://schema.org/hasPart">
        <owl:inverseOf rdf:resource="http://schema.org/isPartOf"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:range rdf:resource="http://schema.org/Room"/>
        <rdfs:comment>Indicates that an entity contains another entity as a part. If something is part of another, the larger entity has that part.</rdfs:comment>
        <rdfs:label>schema:hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/isPartOf -->

    <owl:ObjectProperty rdf:about="http://schema.org/isPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://schema.org/Room"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:comment>Relates an item to a larger item it is a part of.</rdfs:comment>
        <rdfs:label>schema:isPartOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/owns -->

    <owl:ObjectProperty rdf:about="http://schema.org/owns">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#ownedBy"/>
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates an owner to a property or asset they own.</rdfs:comment>
        <rdfs:label>schema:owns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/recipient -->

    <owl:ObjectProperty rdf:about="http://schema.org/recipient">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#recipientOf"/>
        <rdfs:domain rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:range rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:comment>Relates a message, payment, or item to its intended recipient.</rdfs:comment>
        <rdfs:label>schema:recipient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/reservationFor -->

    <owl:ObjectProperty rdf:about="http://schema.org/reservationFor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#hasReservation"/>
        <rdfs:domain rdf:resource="http://schema.org/Reservation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Apartment"/>
                    <rdf:Description rdf:about="http://schema.org/House"/>
                    <rdf:Description rdf:about="http://schema.org/Room"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The thing -- flight, event, restaurant, etc. being reserved.</rdfs:comment>
        <rdfs:label>schema:reservationFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/reviews -->

    <owl:ObjectProperty rdf:about="http://schema.org/reviews">
        <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givesFeedback"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#submittedBy"/>
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:comment>Relates a reviewer to the item they review. Equivalent to givesFeedback.</rdfs:comment>
        <rdfs:label>schema:reviews</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#advertisedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#advertisedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#advertises"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:comment>Relates a property or listing to the agent or organization that advertised it. Inverse of advertises.</rdfs:comment>
        <rdfs:label>advertisedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#advertises -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#advertises">
        <rdfs:domain rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>Relates an agent or organization to a property or listing that it advertises. Inverse of advertisedBy.</rdfs:comment>
        <rdfs:label>advertises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approvedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approvedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approves"/>
        <rdfs:domain rdf:resource="http://schema.org/Reservation"/>
        <rdfs:range rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:comment>Relates an application, request, or document to the entity that approved it. Inverse of approves.</rdfs:comment>
        <rdfs:label>approvedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approves -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approves">
        <rdfs:domain rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:range rdf:resource="http://schema.org/Reservation"/>
        <rdfs:comment>Relates an entity to an application, request, or document that it approves. Inverse of approvedBy.</rdfs:comment>
        <rdfs:label>approves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#complaintFiledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#complaintFiledBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#filesComplaint"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C205529"/>
                    <rdf:Description rdf:about="https://w3id.org/reproduceme#Owner"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates a complaint to the person or organization that filed it. Inverse of filesComplaint.</rdfs:comment>
        <rdfs:label>complaintFiledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#feedbackGivenBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#feedbackGivenBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givesFeedback"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>Relates feedback or a review to the person or entity that gave it. Inverse of givesFeedback.</rdfs:comment>
        <rdfs:label>feedbackGivenBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#filesComplaint -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#filesComplaint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C205529"/>
                    <rdf:Description rdf:about="https://w3id.org/reproduceme#Owner"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint"/>
        <rdfs:comment>Relates a person or organization to a complaint they file. Inverse of complaintFiledBy.</rdfs:comment>
        <rdfs:label>filesComplaint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givesFeedback -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givesFeedback">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:comment>Relates a person to feedback or a review they provide. Equivalent to schema:reviews.</rdfs:comment>
        <rdfs:label>givesFeedback</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#handledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#handledBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#handles"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C48312"/>
        <rdfs:range rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:comment>Relates a case, complaint, or request to the agent or department handling it. Inverse of handles.</rdfs:comment>
        <rdfs:label>handledBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#handles -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#handles">
        <rdfs:domain rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C48312"/>
        <rdfs:comment>Relates an agent or department to a case, complaint, or request they handle. Inverse of handledBy.</rdfs:comment>
        <rdfs:label>handles</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#hasReservation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#hasReservation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Apartment"/>
                    <rdf:Description rdf:about="http://schema.org/House"/>
                    <rdf:Description rdf:about="http://schema.org/Room"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/Reservation"/>
        <rdfs:comment>Indicates the reservations associated with a service or property. If a reservation is for a property, that property has that reservation.</rdfs:comment>
        <rdfs:label>hasReservation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#involvesOwner -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#involvesOwner">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isOwnerInvolvedIn"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:range rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:comment>Relates a transaction, contract, or process to the property owner involved.</rdfs:comment>
        <rdfs:label>involvesOwner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#involvesRenter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#involvesRenter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isInvolvedIn"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:comment>Relates a transaction, contract, or process to the renter involved.</rdfs:comment>
        <rdfs:label>involvesRenter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isInvolvedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isInvolvedIn">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:comment>Relates an entity to a process, event, or transaction in which it participates.</rdfs:comment>
        <rdfs:label>isInvolvedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isLeasedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isLeasedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#leases"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:comment>Relates a property to the tenant who leases it. Inverse of leases.</rdfs:comment>
        <rdfs:label>isLeasedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isManagedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isManagedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#manages"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:comment>Relates a property to the agent or company managing it. Inverse of manages.</rdfs:comment>
        <rdfs:label>isManagedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isOwnerInvolvedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isOwnerInvolvedIn">
        <rdfs:domain rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:comment>Relates a property owner to a transaction, contract, or process they are involved in.</rdfs:comment>
        <rdfs:label>isOwnerInvolvedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isPaidForBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isPaidForBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#paysFor"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>Relates a payment, invoice, or service to the entity that pays for it. Inverse of paysFor.</rdfs:comment>
        <rdfs:label>isPaidForBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isPropertyInvolvedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isPropertyInvolvedIn">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:comment>Relates a property to a transaction, event, or process it is involved in.</rdfs:comment>
        <rdfs:label>isPropertyInvolvedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isReservationMadeBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isReservationMadeBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#makesReservation"/>
        <rdfs:domain rdf:resource="http://schema.org/Reservation"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:comment>Relates a reservation to the person or entity that made it. Inverse of makesReservation.</rdfs:comment>
        <rdfs:label>isReservationMadeBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isSignedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isSignedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#signs"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>Relates a document or contract to the person or entity that signed it.</rdfs:comment>
        <rdfs:label>isSignedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isViewedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#isViewedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#viewsProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>Relates a property or listing to a person who has viewed it.</rdfs:comment>
        <rdfs:label>isViewedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#leases -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#leases">
        <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rents"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>Relates a landlord to a property they lease out. Equivalent to rents.</rdfs:comment>
        <rdfs:label>leases</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#makesReservation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#makesReservation">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:range rdf:resource="http://schema.org/Reservation"/>
        <rdfs:comment>Relates a person or entity to a reservation they create. Inverse of isReservationMadeBy.</rdfs:comment>
        <rdfs:label>makesReservation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#manages -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#manages">
        <rdfs:domain rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates a manager or agency to a property they manage. Inverse of isManagedBy.</rdfs:comment>
        <rdfs:label>manages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#ownedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#ownedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>Indicates the owner of an entity. If a person owns an entity, that entity is owned by that person.</rdfs:comment>
        <rdfs:label>ownedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#paidBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#paidBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#pays"/>
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:comment>Relates a payment or invoice to the payer. Inverse of pays.</rdfs:comment>
        <rdfs:label>paidBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#pays -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#pays">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:range rdf:resource="http://schema.org/RentAction"/>
        <rdfs:comment>Relates a payer to a payment or invoice they make. Inverse of paidBy.</rdfs:comment>
        <rdfs:label>pays</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#paysFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#paysFor">
        <rdfs:domain rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>Relates a payer to the service, product, or reservation they pay for. Inverse of isPaidForBy.</rdfs:comment>
        <rdfs:label>paysFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receivedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receivedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receives"/>
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:comment>Relates a payment, document, or item to the recipient. Inverse of receives.</rdfs:comment>
        <rdfs:label>receivedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receives -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receives">
        <rdfs:domain rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:range rdf:resource="http://schema.org/RentAction"/>
        <rdfs:comment>Relates a recipient to a payment, document, or item they receive. Inverse of receivedBy.</rdfs:comment>
        <rdfs:label>receives</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#recipientOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#recipientOf">
        <rdfs:domain rdf:resource="https://w3id.org/reproduceme#Owner"/>
        <rdfs:range rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>Indicates that an entity is the recipient of a payment, service, message, or transaction.</rdfs:comment>
        <rdfs:label>recipientOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rentedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rentedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rents"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:comment>Relates a property to the tenant who rents it.</rdfs:comment>
        <rdfs:label>rentedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rents -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#rents">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C205529"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>Relates a landlord to a property they lease out. Equivalent to leases.</rdfs:comment>
        <rdfs:label>rents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#signs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#signs">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:comment>Relates a person or entity to a document they sign.</rdfs:comment>
        <rdfs:label>signs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#submittedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#submittedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:range rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>Relates a document, application, or form to the submitter.</rdfs:comment>
        <rdfs:label>submittedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#usedFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#usedFor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#uses"/>
        <rdfs:domain rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:range rdf:resource="http://schema.org/RentAction"/>
        <rdfs:comment>Relates a resource or item to its intended purpose or use.</rdfs:comment>
        <rdfs:label>usedFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#uses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#uses">
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>Relates an entity to another entity, tool, service, or resource that it uses or utilizes.</rdfs:comment>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#viewsProperty -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#viewsProperty">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Relates a person to a property they have viewed or inspected.</rdfs:comment>
        <rdfs:label>viewsProperty</rdfs:label>
    </owl:ObjectProperty>
    


