            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier for an item, such as an ID or code.</rdfs:comment>
        <rdfs:label>schema:identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/interestRate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/interestRate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/Investment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The annual rate charged for borrowing money, expressed as a percentage.</rdfs:comment>
        <rdfs:label>schema:interestRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/license -->

    <owl:DatatypeProperty rdf:about="http://schema.org/license">
        <rdfs:domain rdf:resource="http://schema.org/RealEstateAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A license or permit held by a person or organization.</rdfs:comment>
        <rdfs:label>schema:license</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/location -->

    <owl:DatatypeProperty rdf:about="http://schema.org/location">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01001785"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The location of an event, organization, or property.</rdfs:comment>
        <rdfs:label>schema:location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/name -->

    <owl:DatatypeProperty rdf:about="http://schema.org/name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The name of an item. Equivalent to givenName.</rdfs:comment>
        <rdfs:label>schema:name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/numberOfBathroomsTotal -->

    <owl:DatatypeProperty rdf:about="http://schema.org/numberOfBathroomsTotal">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The total number of bathrooms in a property.</rdfs:comment>
        <rdfs:label>schema:numberOfBathroomsTotal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/numberOfBedrooms -->

    <owl:DatatypeProperty rdf:about="http://schema.org/numberOfBedrooms">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The number of bedrooms in a property.</rdfs:comment>
        <rdfs:label>schema:numberOfBedrooms</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/numberOfRooms -->

    <owl:DatatypeProperty rdf:about="http://schema.org/numberOfRooms">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The total number of rooms in a property.</rdfs:comment>
        <rdfs:label>schema:numberOfRooms</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/occupancy -->

    <owl:DatatypeProperty rdf:about="http://schema.org/occupancy">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The maximum number of people permitted to occupy a property or room.</rdfs:comment>
        <rdfs:label>schema:occupancy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/paymentDueDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/paymentDueDate">
        <rdfs:domain rdf:resource="http://schema.org/Installment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date on which payment is due for an invoice or bill.</rdfs:comment>
        <rdfs:label>schema:paymentDueDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/paymentStatus -->

    <owl:DatatypeProperty rdf:about="http://schema.org/paymentStatus">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Installment"/>
                    <rdf:Description rdf:about="http://schema.org/PaymentService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The status of a payment, e.g., paid, unpaid, pending.</rdfs:comment>
        <rdfs:label>schema:paymentStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/price -->

    <owl:DatatypeProperty rdf:about="http://schema.org/price">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001222"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_01001785"/>
                    <rdf:Description rdf:about="http://schema.org/Apartment"/>
                    <rdf:Description rdf:about="http://schema.org/Hostel"/>
                    <rdf:Description rdf:about="http://schema.org/House"/>
                    <rdf:Description rdf:about="http://schema.org/PaymentService"/>
                    <rdf:Description rdf:about="http://schema.org/RentAction"/>
                    <rdf:Description rdf:about="http://schema.org/Room"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>The price of a product, service, or property.</rdfs:comment>
        <rdfs:label>schema:price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/ratingValue -->

    <owl:DatatypeProperty rdf:about="http://schema.org/ratingValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The numeric rating given in a review or rating, typically on a defined scale of 1-5.</rdfs:comment>
        <rdfs:label>schema:ratingValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/reservationId -->

    <owl:DatatypeProperty rdf:about="http://schema.org/reservationId">
        <rdfs:domain rdf:resource="http://schema.org/Reservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier for a reservation.</rdfs:comment>
        <rdfs:label>schema:reservationId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/reservationstatus -->

    <owl:DatatypeProperty rdf:about="http://schema.org/reservationstatus">
        <rdfs:domain rdf:resource="http://schema.org/Reservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The status of a reservation, e.g., confirmed, cancelled, pending.</rdfs:comment>
        <rdfs:label>schema:reservationstatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/reviewBody -->

    <owl:DatatypeProperty rdf:about="http://schema.org/reviewBody">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The textual content of a review.</rdfs:comment>
        <rdfs:label>schema:reviewBody</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/startDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/startDate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C115464"/>
                    <rdf:Description rdf:about="http://schema.org/Reservation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date on which an event or period begins.</rdfs:comment>
        <rdfs:label>schema:startDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/startTime -->

    <owl:DatatypeProperty rdf:about="http://schema.org/startTime">
        <rdfs:domain rdf:resource="http://schema.org/RentAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The time at which an event or period begins.</rdfs:comment>
        <rdfs:label>schema:startTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/status -->

    <owl:DatatypeProperty rdf:about="http://schema.org/status">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C48312"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The current status of an item or process.</rdfs:comment>
        <rdfs:label>schema:status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/telephone -->

    <owl:DatatypeProperty rdf:about="http://schema.org/telephone">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The telephone number of a person or organization.</rdfs:comment>
        <rdfs:label>schema:telephone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/termsOfService -->

    <owl:DatatypeProperty rdf:about="http://schema.org/termsOfService">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/NCIT_C115464"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The terms and conditions governing the use of a service or product.</rdfs:comment>
        <rdfs:label>schema:termsOfService</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/yearBuilt -->

    <owl:DatatypeProperty rdf:about="http://schema.org/yearBuilt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>The year a property or building was constructed.</rdfs:comment>
        <rdfs:label>schema:yearBuilt</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#bedCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#bedCount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Apartment"/>
                    <rdf:Description rdf:about="http://schema.org/Hostel"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The number of beds available in a room or property.</rdfs:comment>
        <rdfs:label>bedCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givenName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#givenName">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The first name of a person. Equivalent to schema:name.</rdfs:comment>
        <rdfs:label>givenName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#roomType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#roomType">
        <rdfs:domain rdf:resource="http://schema.org/Room"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The type or category of a room, e.g., single, double, studyRoom.</rdfs:comment>
        <rdfs:label>roomType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/ENVO_00000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000073">
        <rdfs:comment>A permanent walled and roofed construction.</rdfs:comment>
        <rdfs:label>Property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01000933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>A human house which serves as a long-term shelter for its inhabitants and within which they store personal property</rdfs:comment>
        <rdfs:label>ResidentialProperty</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>A building which is primarily used to facilitate the buying or selling of goods or services. &quot;Commerce includes legal, economic, political, social, cultural and technological systems that are in operation in any country or internationally.&quot;</rdfs:comment>
        <rdfs:label>CommercialProperty</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_01001785 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01001785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000073"/>
        <rdfs:comment>A surface layer of an astronomical body which is primarily composed of solid material and is not covered by oceans or other bodies of water</rdfs:comment>
        <rdfs:label>Land</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C115464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C115464">
        <rdfs:comment>A legally binding accord between two or more people that details any and all arrangements regarding a specific situation(s).</rdfs:comment>
        <rdfs:label>ContractualAgreement</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C205529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C205529">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Tenant"/>
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>An individual who pays rent to use a home that is owned by someone else</rdfs:comment>
        <rdfs:label>Renter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C48312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C48312">
        <rdfs:comment>Express the need or desire for; ask for</rdfs:comment>
        <rdfs:label>MaintenanceRequest</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Apartment -->

    <owl:Class rdf:about="http://schema.org/Apartment">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Flat"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#bedCount"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a residential apartment used for accomodation.</rdfs:comment>
        <rdfs:label>schema:Apartment</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Hostel -->

    <owl:Class rdf:about="http://schema.org/Hostel">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:comment>Represents a shared accommodation facility for temporary or long-term stay.</rdfs:comment>
        <rdfs:label>schema:Hostel</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/House -->

    <owl:Class rdf:about="http://schema.org/House">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:comment>A house is a building or structure that has the ability to be occupied for habitation by humans or other creatures.</rdfs:comment>
        <rdfs:label>schema:House</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Installment -->

    <owl:Class rdf:about="http://schema.org/Installment">
        <rdfs:subClassOf rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>Represents the installment pricing component of the total price for an offered product.</rdfs:comment>
        <rdfs:label>schema:Installment</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/PaymentService -->

    <owl:Class rdf:about="http://schema.org/PaymentService">
        <rdfs:comment>A Service to transfer funds from a person or organization to a beneficiary person or organization.</rdfs:comment>
        <rdfs:label>schema:PaymentService</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Person -->

    <owl:Class rdf:about="http://schema.org/Person">
        <rdfs:comment>An individual human being. Used to represent people as distinct entities with personal attributes such as name, age, and relationships.&quot;</rdfs:comment>
        <rdfs:label>schema:Person</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/RealEstateAgent -->

    <owl:Class rdf:about="http://schema.org/RealEstateAgent">
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>rdfs:comment &quot;A person or organization licensed to act as an intermediary in the buying, selling, or renting of real estate properties on behalf of clients.&quot;</rdfs:comment>
        <rdfs:label>schema:RealEstateAgent</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/RentAction -->

    <owl:Class rdf:about="http://schema.org/RentAction">
        <rdfs:comment>The act of giving money in return for temporary use, but not ownership, of an object such as a vehicle or property. For example, an agent rents a property from a landlord in exchange for a periodic payment</rdfs:comment>
        <rdfs:label>schema:RentAction</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Reservation -->

    <owl:Class rdf:about="http://schema.org/Reservation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C48312"/>
        <rdfs:comment>Represents the booking or reservation of a property or service for a specified period.</rdfs:comment>
        <rdfs:label>schema:Reservation</rdfs:label>
    </owl:Class>
    


    <!-- http://schema.org/Room -->

    <owl:Class rdf:about="http://schema.org/Room">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:comment>A room is a distinguishable space within a structure, usually separated from other spaces by interior walls.</rdfs:comment>
        <rdfs:label>schema:Room</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Complaint">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C48312"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#submittedBy"/>
                <owl:someValuesFrom rdf:resource="http://schema.org/Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot"/>
        <rdfs:comment>Represents an issue or dissatisfaction reported by a tenant, buyer, or customer regarding a property or service.</rdfs:comment>
        <rdfs:label>Complaint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Deposit -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Deposit">
        <rdfs:subClassOf rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>Money placed into a financial institution, such as a bank, for safekeeping and future withdrawal. The principal is typically preserved, and the account may earn a fixed or variable interest. Deposits are usually accessible on demand or at a set maturity date. Examples: savings accounts, fixed deposits, checking accounts.</rdfs:comment>
        <rdfs:label>Deposit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Feedback">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#receivedBy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/reproduceme#Owner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents reviews,opinions, or ratings provided by users about a property,service, or real estate experience</rdfs:comment>
        <rdfs:label>Feedback</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Flat -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Flat">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000933"/>
        <rdfs:comment>Represents a self-contained residential unit within a building.</rdfs:comment>
        <rdfs:label>Flat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Plot">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#approvedBy"/>
                <owl:someValuesFrom rdf:resource="http://schema.org/RealEstateAgent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a piece of land available for scale,rent, or development.</rdfs:comment>
        <rdfs:label>Plot</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Tenant -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Tenant">
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>rdfs:comment &quot;A person or entity that occupies or uses real property under a lease or rental agreement, typically in exchange for payment.&quot;</rdfs:comment>
        <rdfs:label>Tenant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/Investment -->

    <owl:Class rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/Investment">
        <rdfs:subClassOf rdf:resource="http://schema.org/PaymentService"/>
        <rdfs:comment>An asset or financial instrument purchased with the expectation that it will generate income, increase in value, or both over time. Investments involve risk of loss and the principal is not guaranteed. Examples: stocks, bonds, real estate, mutual funds.</rdfs:comment>
        <rdfs:label>Investment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/reproduceme#Owner -->

    <owl:Class rdf:about="https://w3id.org/reproduceme#Owner">
        <rdfs:subClassOf rdf:resource="http://schema.org/Person"/>
        <rdfs:comment>A person who owns a certain land.</rdfs:comment>
        <rdfs:label>Owner</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#AdvanceInvestment -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#AdvanceInvestment">
        <rdf:type rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33/Investment"/>
        <schema1:amount rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10000.0</schema1:amount>
        <schema1:interestRate rdf:datatype="http://www.w3.org/2001/XMLSchema#float">2.5</schema1:interestRate>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Agent1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Agent1">
        <rdf:type rdf:resource="http://schema.org/RealEstateAgent"/>
        <untitled-ontology-33:manages rdf:resource="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Property001"/>
        <schema1:areaServed>Sargodha</schema1:areaServed>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Agent2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/dell/ontologies/2026/3/untitled-ontology-33#Agent2">
        <rdf:type rdf:resource="http://schema.org/RealEstateAgent"/>
